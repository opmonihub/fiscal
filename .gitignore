# Dados e artefatos locais nunca pertencem ao repositório público.
.env
.env.*
!.env.example
__pycache__/
*.py[cod]
.venv/
node_modules/
dist/
coverage/
*.log
*.pdf
*.xml
*.xlsx
*.xls
*.csv
*.zip
.fiscal/
.data-app-offline/
.data-app-preview/
.data-app-publish/
frontend/src/data.json
frontend/src/content/dashboard/xml-previews.json
frontend/public/
frontend/.artifacts/
frontend/.data-app-build/
frontend/.data-app-offline/
frontend/dist*/
frontend/node_modules*/
frontend/.data-app*/
frontend/.openai/
frontend/*.png
frontend/src/data*.json
frontend/src/content/dashboard/xml-previews*.json
